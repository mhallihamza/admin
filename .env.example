# Root-level environment variable names.
# Copy to .env.local / per-service env files and fill values. Never commit real values.

# --- Supabase (frontend auth + application data) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase server-side only (migrations; FastAPI backend) ---
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- FastAPI backend (agent tokens, limits, hooks) ---
AGENT_TOKEN_SECRET=
AGENT_TOKEN_TTL_SECONDS=
UPLOAD_MAX_SIZE_MB=
UPLOAD_MAX_PAGES=
RATE_LIMIT_CHAT_PER_MIN=
RATE_LIMIT_UPLOAD_PER_MIN=
RATE_LIMIT_DEFAULT_PER_MIN=
MALWARE_SCAN_URL=
# --- LangGraph workflow service (Phase 5, replaces Langflow) ---
LANGGRAPH_SECURITY_GATE_URL=http://localhost:8101/run/detect
LANGGRAPH_BASE_URL=http://localhost:8101
LANGGRAPH_FLOW_TOKEN=
BACKEND_PUBLIC_URL=http://localhost:8100
ALLOWED_ORIGINS=

# --- LangGraph workflow service runtime (langgraph/, replaces Langflow) ---
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
