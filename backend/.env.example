# Backend-only environment variables (server side — never exposed to the browser).
# Values live in .env.local (gitignored). Names only here.

# Supabase (same values as the root .env.local)
SUPABASE_URL=
SUPABASE_DB_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backend-issued agent tokens (own HMAC secret, distinct from Supabase keys)
AGENT_TOKEN_SECRET=
AGENT_TOKEN_TTL_SECONDS=60

# Upload limits
UPLOAD_MAX_SIZE_MB=20
UPLOAD_MAX_PAGES=300

# Rate limits (requests per minute)
RATE_LIMIT_CHAT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_DEFAULT_PER_MIN=120

# Optional malware scan hook (ClamAV REST, VirusTotal proxy, ...)
MALWARE_SCAN_URL=

# Optional Langflow security gate (Layer 2 detection agent) — Phase 5
LANGFLOW_SECURITY_GATE_URL=
LANGFLOW_SECURITY_GATE_TOKEN=

# CORS (frontend origin)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100
