# Guide Administratif — LangGraph workflow service (names only; real values
# live in langgraph/.env, never committed). The backend also reads a few of
# these from the shared root .env.local.

# LLM + embeddings (Mistral)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Astra DB — vector store (collection admin_guide_chunks)
ASTRA_DB_APPLICATION_TOKEN=
ASTRA_DB_API_ENDPOINT=
ASTRA_DB_KEYSPACE=

# Neo4j — graph store (flows 03/05)
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Supabase — incidents written directly by the gate (flow 01, service key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for API auth (header X-Flow-Token). Empty = open in dev.
FLOW_TOKEN=

# Where the backend gateway lives (specialists call back into it)
BACKEND_GATEWAY_URL=http://localhost:8100
